generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lawyer {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phone       String?
  barCouncilId String?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    CaseSession[]
}

model CaseSession {
  id          String    @id @default(cuid())
  lawyerId    String
  lawyer      Lawyer    @relation(fields: [lawyerId], references: [id])
  clientName  String?
  clientPhone String?
  backendSessionId String  @unique  // The FastAPI thread_id
  status      String    @default("INTAKE")  // INTAKE | ANALYSIS | DONE
  shareLink   String    @unique  // Generated sharable link token
  callStatus       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DISCONNECTED
  callSummary      String?
  callAttempts     Int       @default(0)
  callDuration     Int       @default(0) // in seconds
  lastCallAt       DateTime?
  factsCount       Int       @default(0)
  flagsCount       Int       @default(0)
  calls            CallLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CallLog {
  id          String      @id @default(cuid())
  sessionId   String
  session     CaseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      String      // COMPLETED | DISCONNECTED
  duration    Int         @default(0) // seconds
  summary     String?
  factsCount  Int         @default(0)
  createdAt   DateTime    @default(now())
}
