# NyayaLens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional text reasoning fallback when Gemini is overloaded or quota-limited
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_PROVIDER=gemini
LITELLM_API_KEY=your_hackathon_api_key_here
LITELLM_BASE_URL=https://litellm-hackathon.penpencil.guru
LITELLM_MODEL=gpt-6-luna
LITELLM_TEAM_CODE=your_team_code
MODEL_FLASH=gemini-3.1-flash-lite
MODEL_PRO=gemini-3.5-flash
MODEL_SEARCH=gemini-3.1-flash-lite

# Sarvam speech (backend only; never put this key in a NEXT_PUBLIC variable)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=ishita_enhi_customer

# Indian Kanoon API Token (required for live legal research)
# Register at: https://api.indiankanoon.org and generate token from dashboard
# Non-commercial/academic projects get free credit — apply at contact page
INDIAN_KANOON_TOKEN=your_indian_kanoon_api_token_here
